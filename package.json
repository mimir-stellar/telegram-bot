{
  "name": "@mimir-stellar/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram notifier for Mimir's Soroban contracts on Stellar Testnet: polls mimir-market and mimir-squad events and posts them to a chat.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "lockfile:reproduce": "node scripts/check-lockfile.mjs --reproduce",
    "test": "npm run build && node --test --test-timeout=120000 tests/*.test.mjs",
    "test:mock": "npm run build && node --test --test-timeout=120000 tests/mock-*.test.mjs",
    "scan": "tsx src/stellar/events.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:mock": "tsx src/stellar/events.ts --mock",
    "mock:rpc": "tsx src/stellar/mock-rpc.ts",
    "mock:telegram": "tsx src/dev/fake-telegram.ts",
    "mock:poll": "tsx src/mock-run.ts",
    "mock:stack": "docker compose -f docker-compose.mock.yml up --build",
    "mock:stack:down": "docker compose -f docker-compose.mock.yml down -v",
    "audit": "tsx src/audit-cli.ts",
    "audit:report": "tsx src/audit-cli.ts",
    "seed:cursor": "tsx src/dev/seedCursor.ts",
    "cursor": "node dist/cursor-cli.js",
    "replay": "tsx src/replay-cli.ts",
    "replay:mock": "tsx src/replay-cli.ts --mock",
    "decode": "tsx src/decode-cli.ts",
    "doctor": "tsx src/doctor-cli.ts"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/index.ts",
      "src/stellar/events.ts",
      "src/stellar/client.ts",
      "src/dev/fake-telegram.ts"
    ],
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "c8": "^10.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
