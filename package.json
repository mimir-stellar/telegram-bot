{
  "name": "@mimir-stellar/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram notifier for Mimir's Soroban contracts on Stellar Testnet: polls mimir-market and mimir-squad events and posts them to a chat.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && c8 node --test tests/*.test.mjs",
    "scan": "tsx src/stellar/events.ts"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/index.ts",
      "src/stellar/events.ts",
      "src/stellar/client.ts"
    ],
    "check-coverage": true,
    "lines": 80,
    "statements": 80,
    "functions": 80,
    "branches": 80
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "c8": "^10.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
