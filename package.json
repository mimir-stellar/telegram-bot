{
  "name": "@mimir-stellar/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram notifier for Mimir's Soroban contracts on Stellar Testnet: polls mimir-market and mimir-squad events and posts them to a chat.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lockfile:check": "node scripts/check-lockfile.mjs",
    "lockfile:reproduce": "node scripts/check-lockfile.mjs --reproduce",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:mock": "npm run build && node --test tests/mock-*.test.mjs",
    "scan": "tsx src/stellar/events.ts",
    "scan:mock": "tsx src/stellar/events.ts --mock",
    "mock:rpc": "tsx src/stellar/mock-rpc.ts",
    "mock:poll": "tsx src/mock-run.ts",
    "audit": "tsx src/audit-cli.ts",
    "audit:report": "tsx src/audit-cli.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "dotenv": "^18.0.3",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
